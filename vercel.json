      "destination": "/api/3dlook-api?route=check-status"
    },
    {
      "source": "/api/3dlook/save-measurements",
      "destination": "/api/3dlook-api?route=save-measurements"
    },
    {
      "source": "/api/3dlook/webhook",
      "destination": "/api/3dlook-api?route=webhook"
