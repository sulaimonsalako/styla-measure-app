    {
      "source": "/connect",
      "destination": "/connect.html"
    },
    {
      "source": "/brands",
      "destination": "/brands.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "styla.ca" }],
      "destination": "https://www.styla.ca/:path*",
      "permanent": true
    }
  ]
