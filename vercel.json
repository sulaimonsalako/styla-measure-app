    {
      "source": "/api/brand-sync",
      "destination": "/api/store-api?route=brand-sync"
    },
    {
      "source": "/api/party",
      "destination": "/api/store-api?route=party"
    },
    {
      "source": "/api/account",
      "destination": "/api/store-api?route=account"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/store-api?route=feedback"
    },
    {
      "source": "/api/subscribe",
      "destination": "/api/store-api?route=subscribe"
