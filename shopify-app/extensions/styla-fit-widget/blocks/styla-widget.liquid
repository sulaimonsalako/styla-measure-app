{% comment %}
  STYLA Fit Advisor storefront widget block.

  SIZE-AXIS GATE. There is nothing to advise on a product with no sizes — a
  one-size hat, a gift card, a candle. Showing "Find my size" there invites a
  click we can only answer with "we can't help", which is worse than not asking.
  So decide at RENDER time, in Liquid: no flash of a button that then vanishes,
  and no wasted API call.

  Mirrors shared/variant-size.js: match the option by NAME (option positions are
  arbitrary — plenty of stores order Colour first). Liquid can't call that
  module, so the rule is repeated here; keep the two in step.
{% endcomment %}
{%- assign styla_size_names = 'size,sizes,taille,talla,grösse,groesse,tamanho,misura,maat,storlek,us size,uk size,eu size' -%}
{%- assign styla_has_size = false -%}
{%- for opt in product.options_with_values -%}
  {%- assign opt_name = opt.name | downcase | strip -%}
  {%- if styla_size_names contains opt_name -%}
    {%- if opt.values.size > 1 -%}{%- assign styla_has_size = true -%}{%- endif -%}
  {%- endif -%}
{%- endfor -%}
{%- comment -%}
  Fallback: a single unnamed option with several values is almost always the size
  (common on minimal themes). A product with only Shopify's default variant never is.
{%- endcomment -%}
{%- if styla_has_size == false and product.has_only_default_variant == false and product.options.size == 1 -%}
  {%- assign only_opt = product.options_with_values | first -%}
  {%- if only_opt.values.size > 1 -%}{%- assign styla_has_size = true -%}{%- endif -%}
{%- endif -%}

{%- if styla_has_size or block.settings.show_without_sizes -%}
<div class="styla-widget-container"
     id="styla-widget-{{ block.id }}"
     data-product-id="{{ product.id }}"
     data-product-title="{{ product.title | escape }}"
     data-product-handle="{{ product.handle }}"
     data-product-type="{{ product.type | escape }}"
     data-product-url="{{ shop.url }}{{ product.url }}"
     data-shop-domain="{{ shop.permanent_domain }}"
     data-product-desc="{{ product.description | strip_html | truncate: 2500 | escape }}"
     data-customer-id="{{ customer.id }}"
     data-country="{{ localization.country.iso_code }}"
     data-locale="{{ request.locale.iso_code }}"
     data-has-size-axis="{{ styla_has_size }}"
     data-hide-without-chart="{{ block.settings.hide_without_chart }}"
     data-size-values="{% for opt in product.options_with_values %}{%- assign n = opt.name | downcase | strip -%}{% if styla_size_names contains n %}{{ opt.values | join: '|' | escape }}{% endif %}{% endfor %}"
     {{ block.shopify_attributes }}>
     
  {%- comment -%}
    Variant data for "add my size to the bag". Passing it as JSON here is far more
    reliable than scraping the theme's DOM: option NAMES are preserved (positions
    are arbitrary), and we get the real variant ids, so add-to-cart works even on
    themes whose pickers we can't parse.
  {%- endcomment -%}
  <script type="application/json" class="styla-variant-data">
    {
      "options": {{ product.options | json }},
      "variants": [
        {%- for v in product.variants -%}
          {"id": {{ v.id }}, "available": {{ v.available }}, "title": {{ v.title | json }},
           "options": {{ v.options | json }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>

  <!-- PDP Button -->
  <button type="button" class="styla-fit-btn" id="styla-trigger-btn-{{ block.id }}" style="
    --btn-bg: {{ block.settings.btn_bg }};
    --btn-color: {{ block.settings.btn_color }};
  ">
    <svg class="styla-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    </svg>
    <span class="styla-btn-text">{{ block.settings.btn_label }}</span>
  </button>
</div>

<!-- Modal Structure (Text-based Layout) -->
<div class="styla-modal-overlay styla-hidden" id="styla-modal-{{ block.id }}">
  <div class="styla-modal-container">
    <!-- Close Button -->
    <button class="styla-modal-close" id="styla-close-{{ block.id }}">&times;</button>
    
    <div class="styla-modal-body">
      <!-- Header: a small thumbnail confirms WHICH product is being sized without
           stealing half the width. The old left-hand image column is what forced
           the content into a narrow, three-line-wrapping column. -->
      <div class="styla-modal-head">
        {% if product.featured_image %}
          <img class="styla-head-thumb" src="{{ product.featured_image | image_url: width: 160 }}" alt="{{ product.title | escape }}" width="48" height="60" loading="lazy">
        {% endif %}
        <div class="styla-head-text">
          <span class="styla-head-title">{{ product.title | escape }}</span>
          <span class="styla-head-sub" id="styla-head-sub-{{ block.id }}">Fit &amp; size advice for your body</span>
        </div>
        <div class="styla-authslot">
          <!-- Shoppers look for "size chart" by name; it was buried as the fifth
               link in the sub-row and hidden until a chart loaded. Give it a home in
               the header. Hidden until we actually have a chart to show. -->
          <button type="button" class="styla-head-chart styla-hidden" id="styla-head-chart-{{ block.id }}">Size chart</button>
          <button type="button" class="styla-connect-btn styla-hidden" id="styla-connect-top-{{ block.id }}">Continue with Styla</button>
          <button type="button" class="styla-signout styla-hidden" id="styla-signout-{{ block.id }}">Sign out</button>
        </div>
      </div>

      <!-- ONE scrolling panel: pinned answer, then inline panels, then the chat.
           No tabs — the recommendation stays visible while you ask about it. -->
      <div class="styla-modal-right">
        <div class="styla-pane" id="styla-tab-fit-{{ block.id }}">
          <div class="styla-text-rec-container">

            <!-- THE ANSWER, as a sub-header: one compact sticky line, so the size
                 stays visible while the shopper reads or chats. Everything else
                 is behind a link so the conversation area stays clean. -->
            <div class="styla-subhead" id="styla-answer-{{ block.id }}">
              <div class="styla-sub-row">
                <span class="styla-sub-label">YOUR SIZE</span>
                <span class="styla-sub-size">
                  <span id="styla-best-size-val-{{ block.id }}">—</span>
                  <svg class="styla-check-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </span>
                <span class="styla-sub-meta" id="styla-conf-{{ block.id }}"></span>
                <span class="styla-sub-meta" id="styla-answer-len-{{ block.id }}"></span>
                <span class="styla-sub-spacer"></span>
              </div>
              <!-- Act on the answer: the size is useless if the shopper still has
                   to go hunt for it in the theme's picker. -->
              <div class="styla-action" id="styla-action-{{ block.id }}"></div>
              <div class="styla-sub-links">
                {%- comment -%}
                  Two tiers, not five peers. "Why this size" and "Other sizes" are
                  what shoppers actually open; the chart and their own measurements
                  are reference material and shouldn't compete for the same weight.
                {%- endcomment -%}
                <button type="button" class="styla-lnk" id="styla-lnk-fit-{{ block.id }}" aria-expanded="false">Why this size</button>
                <button type="button" class="styla-lnk" id="styla-lnk-sizes-{{ block.id }}" aria-expanded="false">Other sizes</button>
                <button type="button" class="styla-lnk styla-hidden" id="styla-lnk-len-{{ block.id }}" aria-expanded="false">Length</button>
                <span class="styla-lnk-sep" aria-hidden="true"></span>
                <button type="button" class="styla-lnk styla-lnk-quiet styla-hidden" id="styla-lnk-chart-{{ block.id }}" aria-expanded="false">Size chart</button>
                <button type="button" class="styla-lnk styla-lnk-quiet" id="styla-edit-specs-{{ block.id }}">My measurements</button>
              </div>
            </div>

            <div class="styla-cuts styla-hidden" id="styla-cuts-{{ block.id }}"></div>

            <div class="styla-shopfor-row" id="styla-shopfor-slot-{{ block.id }}"></div>

            <div class="styla-panels styla-fit-details-body" id="styla-details-body-{{ block.id }}">
              <div class="styla-disc-body styla-hidden" id="styla-disc-fit-{{ block.id }}">
                <ul class="styla-text-analysis-list" id="styla-text-list-{{ block.id }}"></ul>
                <p class="styla-alt-note" id="styla-intent-text-{{ block.id }}" style="text-align:left"></p>
              </div>
              <div class="styla-disc-body styla-hidden" id="styla-disc-sizes-{{ block.id }}">
                <div id="styla-sizes-body-{{ block.id }}"></div>
              </div>
              <div class="styla-disc-body styla-hidden" id="styla-disc-len-{{ block.id }}">
                <div id="styla-len-body-{{ block.id }}"></div>
              </div>
              <div class="styla-disc-body styla-chart-wrap styla-hidden" id="styla-disc-chart-{{ block.id }}">
                <div id="styla-chart-body-{{ block.id }}"></div>
              </div>
              <div class="styla-hidden" id="styla-intent-card-{{ block.id }}"></div>
            </div>

            <!-- Manual Specs Input Form (Hidden by default) -->
            <div class="styla-specs-form styla-hidden" id="styla-form-{{ block.id }}">
              <div class="styla-gift styla-hidden" id="styla-forwho-{{ block.id }}">
                <p class="styla-gift-intro">Answer what you know about them. Nothing here needs a tape measure — or an awkward question.</p>

                <div class="styla-q">
                  <label>Who is it for? <span class="styla-req">Required</span></label>
                  <div class="styla-seg" id="styla-g-gender-{{ block.id }}">
                    <button type="button" data-v="women" class="on">Women's</button>
                    <button type="button" data-v="men">Men's</button>
                  </div>
                </div>

                {%- comment -%}
                  Naming them is what makes saving them the shopper's decision. The
                  widget used to auto-save every estimate as "Friend 1", "Friend 2"
                  — nobody asked for that, and the names meant nothing afterwards.
                  Blank = use it now, remember nothing.
                {%- endcomment -%}
                <div class="styla-q">
                  <label for="styla-g-name-{{ block.id }}">Their name <span class="styla-opt">Optional</span></label>
                  <input type="text" id="styla-g-name-{{ block.id }}" placeholder="e.g. Mum" maxlength="24" autocomplete="off">
                  <p class="styla-hint-sm">Only so you can pick them again next time. Leave it blank and we won’t save anything.</p>
                </div>

                <!-- Gender-specific, because the useful question differs. A man
                     usually knows his jacket number (which IS his chest in inches);
                     a woman knows a dress size, but only alongside its system. -->
                <div class="styla-q styla-hidden" id="styla-g-men-size-{{ block.id }}">
                  <label>Their suit or jacket size <span class="styla-opt">Optional</span></label>
                  <div class="styla-inline">
                    <div class="styla-seg styla-seg-sm" id="styla-g-msys-{{ block.id }}">
                      <button type="button" data-v="us" class="on">US/UK</button>
                      <button type="button" data-v="eu">EU</button>
                    </div>
                    <input type="text" id="styla-g-suit-{{ block.id }}" placeholder="40" maxlength="4" inputmode="numeric" style="width:96px">
                  </div>
                  <p class="styla-hint-sm">A jacket number is his chest in inches — the most useful thing you can know. Skip if unsure.</p>
                </div>

                <div class="styla-q" id="styla-g-women-size-{{ block.id }}">
                  <label>The size she usually wears <span class="styla-opt">Optional</span></label>
                  <div class="styla-inline">
                    <div class="styla-seg styla-seg-sm styla-seg-wrap" id="styla-g-wsys-{{ block.id }}">
                      <button type="button" data-v="uk" class="on">UK</button>
                      <button type="button" data-v="us">US</button>
                      <button type="button" data-v="eu">EU</button>
                      <button type="button" data-v="au">AUS</button>
                      <button type="button" data-v="it">IT</button>
                      <button type="button" data-v="fr">FR</button>
                    </div>
                    <input type="text" id="styla-g-wsize-{{ block.id }}" placeholder="12" maxlength="4" inputmode="numeric" style="width:96px">
                  </div>
                  <p class="styla-hint-sm">If you've seen a label, this sharpens things a lot. Skip it if you don't know.</p>
                </div>

                <div class="styla-q">
                  <label>How tall are they? <span class="styla-req">Required</span></label>
                  <div class="styla-unitbar" style="margin-bottom:8px">
                    <div class="styla-seg styla-unit-seg" id="styla-g-unit-{{ block.id }}">
                      <button type="button" data-v="in">ft·in</button>
                      <button type="button" data-v="cm">cm</button>
                    </div>
                  </div>
                  <span class="styla-hgroup" id="styla-g-himp-{{ block.id }}">
                    <input type="number" id="styla-g-hft-{{ block.id }}" placeholder="5" min="3" max="7">
                    <span class="styla-hunit">ft</span>
                    <input type="number" id="styla-g-hin-{{ block.id }}" placeholder="8" min="0" max="11">
                    <span class="styla-hunit">in</span>
                  </span>
                  <span class="styla-hgroup styla-hidden" id="styla-g-hmet-{{ block.id }}">
                    <input type="number" id="styla-g-hcm-{{ block.id }}" placeholder="173" min="120" max="215">
                    <span class="styla-hunit">cm</span>
                  </span>
                  <p class="styla-hint-sm" id="styla-g-hhint-{{ block.id }}">A guess is fine. This is what decides Short / Regular / Long.</p>
                </div>

                <div class="styla-q">
                  <label>How would you describe their build? <span class="styla-opt">Optional</span></label>
                  <div class="styla-seg styla-seg-wrap" id="styla-g-build-{{ block.id }}">
                    <button type="button" data-v="slim">Slim</button>
                    <button type="button" data-v="average" class="on">Average</button>
                    <button type="button" data-v="curvy">Curvy</button>
                  </div>
                </div>

                <div class="styla-form-actions">
                  <button type="button" class="styla-form-btn cancel" id="styla-g-cancel-{{ block.id }}">Cancel</button>
                  <button type="button" class="styla-form-btn save" id="styla-g-save-{{ block.id }}">Find their size</button>
                </div>
              </div>

              <div class="styla-chooser" id="styla-chooser-{{ block.id }}">
                <p class="styla-chooser-intro">How should we work out your size?<span>Pick whichever you know — we’ll do the rest.</span></p>

                <button type="button" class="styla-card" data-view="quiz">
                  <span class="styla-card-ico" aria-hidden="true">✎</span>
                  <span class="styla-card-txt">
                    <b>Answer a few questions</b>
                    <em>No tape measure. Takes about 20 seconds.</em>
                  </span>
                  <span class="styla-card-go" aria-hidden="true">›</span>
                </button>

                <button type="button" class="styla-card" data-view="known">
                  <span class="styla-card-ico" aria-hidden="true">#</span>
                  <span class="styla-card-txt">
                    <b>Use a size you already wear</b>
                    <em>UK, EU, US, AUS, IT or FR.</em>
                  </span>
                  <span class="styla-card-go" aria-hidden="true">›</span>
                </button>

                <button type="button" class="styla-card" data-view="manual">
                  <span class="styla-card-ico" aria-hidden="true">↔</span>
                  <span class="styla-card-txt">
                    <b>Enter your measurements</b>
                    <em>Most accurate, if you have them.</em>
                  </span>
                  <span class="styla-card-go" aria-hidden="true">›</span>
                </button>
              </div>

              <div class="styla-formhead styla-hidden" id="styla-formhead-{{ block.id }}">
                <button type="button" class="styla-back" id="styla-back-{{ block.id }}">&larr; Back</button>
                <span class="styla-form-title" id="styla-form-title-{{ block.id }}">A few quick questions — no tape measure needed.</span>
              </div>

              <!-- QUESTIONNAIRE (default) -->
              <div id="styla-quiz-{{ block.id }}">
                <div class="styla-q">
                  <label>You're shopping for</label>
                  <div class="styla-seg" id="styla-q-gender-{{ block.id }}">
                    <button type="button" data-g="women" class="on">Women's</button>
                    <button type="button" data-g="men">Men's</button>
                  </div>
                </div>
                <div class="styla-q">
                  <label>Height <span class="styla-qval" id="styla-q-hlbl-{{ block.id }}">5'6"</span></label>
                  <input type="range" id="styla-q-height-{{ block.id }}" min="54" max="82" value="66">
                </div>
                <div class="styla-q">
                  <label>Weight <span class="styla-qval" id="styla-q-wlbl-{{ block.id }}">150 lb</span></label>
                  <input type="range" id="styla-q-weight-{{ block.id }}" min="90" max="330" value="150">
                </div>

                <div id="styla-q-women-{{ block.id }}">
                  <div class="styla-form-grid">
                    <div class="styla-form-group">
                      <label>Bra band</label>
                      <select id="styla-q-band-{{ block.id }}"><option>30</option><option>32</option><option selected>34</option><option>36</option><option>38</option><option>40</option><option>42</option></select>
                    </div>
                    <div class="styla-form-group">
                      <label>Cup</label>
                      <select id="styla-q-cup-{{ block.id }}"><option>A</option><option selected>B</option><option>C</option><option>D</option><option>DD</option><option>F</option></select>
                    </div>
                  </div>
                  <div class="styla-q">
                    <label>Usual waist size (in) <span class="styla-qval" id="styla-q-wwlbl-{{ block.id }}">28 in</span></label>
                    <input type="range" id="styla-q-ww-{{ block.id }}" min="22" max="48" value="28">
                    {%- comment -%}
                      Optional, and only useful when it differs. A waistband is
                      pulled OVER the stomach, so for anyone whose belly exceeds
                      their natural waist this is the measurement that decides
                      whether the garment closes at all.
                    {%- endcomment -%}
                    <label>Stomach at its fullest <span class="styla-opt">optional</span></label>
                    <div class="styla-qhint">Only if it's bigger than your waist — that's what decides whether a waistband closes.</div>
                    <div class="styla-belly-row">
                      <input type="number" step="0.5" inputmode="decimal" id="styla-q-belly-{{ block.id }}">
                      <span class="styla-belly-unit" id="styla-q-belly-unit-{{ block.id }}">in</span>
                    </div>
                  </div>
                </div>

                <div id="styla-q-men-{{ block.id }}" style="display:none">
                  <div class="styla-form-group">
                    <label>Usual shirt size</label>
                    <select id="styla-q-shirt-{{ block.id }}"><option>XS</option><option>S</option><option selected>M</option><option>L</option><option>XL</option><option>XXL</option></select>
                  </div>
                  <div class="styla-q">
                    <label>Usual waist size (in) <span class="styla-qval" id="styla-q-wmlbl-{{ block.id }}">32 in</span></label>
                    <input type="range" id="styla-q-wm-{{ block.id }}" min="26" max="54" value="32">
                    {%- comment -%}
                      Optional, and only useful when it differs. A waistband is
                      pulled OVER the stomach, so for anyone whose belly exceeds
                      their natural waist this is the measurement that decides
                      whether the garment closes at all.
                    {%- endcomment -%}
                    <label>Stomach at its fullest <span class="styla-opt">optional</span></label>
                    <div class="styla-qhint">Only if it's bigger than your waist — that's what decides whether a waistband closes.</div>
                    <div class="styla-belly-row">
                      <input type="number" step="0.5" inputmode="decimal" id="styla-q-belly-{{ block.id }}">
                      <span class="styla-belly-unit" id="styla-q-belly-unit-{{ block.id }}">in</span>
                    </div>
                  </div>
                </div>

                <div class="styla-q">
                  <label>How do you like things to fit?</label>
                  <div class="styla-seg" id="styla-q-fit-{{ block.id }}">
                    <button type="button" data-f="snug">Fitted</button>
                    <button type="button" data-f="regular" class="on">Regular</button>
                    <button type="button" data-f="loose">Relaxed</button>
                  </div>
                </div>
              </div>

              <!-- EXACT MEASUREMENTS (optional) -->
              <div id="styla-manual-{{ block.id }}" style="display:none">
                <div class="styla-unitbar">
                  <span class="styla-unitbar-lbl">Measurements in</span>
                  <div class="styla-seg styla-unit-seg" id="styla-unit-{{ block.id }}">
                    <button type="button" data-v="in">in</button>
                    <button type="button" data-v="cm">cm</button>
                  </div>
                </div>
                <div class="styla-form-grid">
                  <div class="styla-form-group">
                    <label for="styla-in-chest-{{ block.id }}">Chest / bust <span class="styla-u">(in)</span></label>
                    <input type="number" id="styla-in-chest-{{ block.id }}" placeholder="38" step="0.5">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-in-waist-{{ block.id }}">Waist <span class="styla-u">(in)</span></label>
                    <input type="number" id="styla-in-waist-{{ block.id }}" placeholder="32" step="0.5">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-in-hips-{{ block.id }}">Hips <span class="styla-u">(in)</span></label>
                    <input type="number" id="styla-in-hips-{{ block.id }}" placeholder="40" step="0.5">
                  </div>

                  <!-- Height: nobody thinks of themselves as "66 inches". -->
                  <div class="styla-form-group">
                    <label>Height</label>
                    <span class="styla-hgroup" id="styla-h-imp-{{ block.id }}">
                      <input type="number" id="styla-in-hft-{{ block.id }}" placeholder="5" min="3" max="7">
                      <span class="styla-hunit">ft</span>
                      <input type="number" id="styla-in-hin-{{ block.id }}" placeholder="6" min="0" max="11">
                      <span class="styla-hunit">in</span>
                    </span>
                    <span class="styla-hgroup styla-hidden" id="styla-h-met-{{ block.id }}">
                      <input type="number" id="styla-in-hcm-{{ block.id }}" placeholder="168" min="120" max="215">
                      <span class="styla-hunit">cm</span>
                    </span>
                  </div>

                  <div class="styla-form-group">
                    <label for="styla-in-shoulders-{{ block.id }}">Shoulder <span class="styla-u">(in)</span> <span class="styla-opt">optional</span></label>
                    <input type="number" id="styla-in-shoulders-{{ block.id }}" placeholder="17" step="0.1">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-in-inseam-{{ block.id }}">Inseam <span class="styla-u">(in)</span> <span class="styla-opt">optional</span></label>
                    <input type="number" id="styla-in-inseam-{{ block.id }}" placeholder="30" step="0.5">
                  </div>
                </div>
              </div>

              <div class="styla-known styla-hidden" id="styla-known-{{ block.id }}">
                <p class="styla-gift-intro">Tell us a size you already wear — UK, EU, US, AUS, IT or FR — and we’ll work out what that means in this brand.</p>

                <div class="styla-q">
                  <label>Which sizing? <span class="styla-req">Required</span></label>
                  <div class="styla-seg styla-seg-wrap" id="styla-k-system-{{ block.id }}">
                    <button type="button" data-v="us" class="on">US</button>
                    <button type="button" data-v="uk">UK</button>
                    <button type="button" data-v="eu">EU</button>
                    <button type="button" data-v="au">AUS</button>
                    <button type="button" data-v="it">IT</button>
                    <button type="button" data-v="fr">FR</button>
                  </div>
                </div>

                <div class="styla-form-grid">
                  <div class="styla-form-group">
                    <label for="styla-k-size-{{ block.id }}">Your size <span class="styla-req">Required</span></label>
                    <input type="text" id="styla-k-size-{{ block.id }}" placeholder="12" maxlength="5" inputmode="numeric">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-k-height-{{ block.id }}">Height <span class="styla-req">Required</span></label>
                    <span style="display:inline-flex;gap:5px;align-items:center">
                      <input type="number" id="styla-k-hft-{{ block.id }}" placeholder="5" min="3" max="7" style="width:56px">
                      <span class="styla-hint-sm">ft</span>
                      <input type="number" id="styla-k-hin-{{ block.id }}" placeholder="6" min="0" max="11" style="width:56px">
                      <span class="styla-hint-sm">in</span>
                    </span>
                  </div>
                </div>
                <p class="styla-hint-sm" id="styla-k-equiv-{{ block.id }}">A size label doesn't say how tall you are — and height is what decides Short, Regular or Long.</p>

                <div class="styla-q">
                  <label for="styla-k-brand-{{ block.id }}">Where is that size from? <span class="styla-opt">Optional</span></label>
                  <input type="text" id="styla-k-brand-{{ block.id }}" placeholder="e.g. Zara — if we hold their chart we can be exact" maxlength="40">
                </div>

                <div class="styla-q">
                  <label>How would you describe your build? <span class="styla-opt">Optional</span></label>
                  <div class="styla-seg styla-seg-wrap" id="styla-k-build-{{ block.id }}">
                    <button type="button" data-v="slim">Slim</button>
                    <button type="button" data-v="average" class="on">Average</button>
                    <button type="button" data-v="curvy">Curvy</button>
                  </div>
                </div>

                <div class="styla-form-actions">
                  <button type="button" class="styla-form-btn save" id="styla-k-save-{{ block.id }}">Find my size here</button>
                </div>
              </div>

              <div class="styla-form-actions">
                <button type="button" class="styla-form-btn cancel" id="styla-cancel-specs-{{ block.id }}">Cancel</button>
                <button type="button" class="styla-form-btn save" id="styla-save-specs-{{ block.id }}">Calculate Fit</button>
              </div>
            </div>
            
          </div>
        </div>
        
        <!-- Conversation, in the same scroll and below the answer. -->
        <div class="styla-chat-container" id="styla-tab-chat-{{ block.id }}">
          <div class="styla-chat-head">Ask about this item</div>
          <div class="styla-chat-history" id="styla-chat-history-{{ block.id }}">
            <div class="chat-msg system"><p>Ask me anything — other sizes, length, fabric, or how this compares to something you already own.</p></div>
          </div>
          <div class="styla-chat-suggest" id="styla-chat-suggest-{{ block.id }}"></div>
        </div>
      </div>

      <!-- Composer: a sibling of the scroll area, so it stays put. -->
      <div class="styla-composer">
        <textarea class="styla-chat-input" id="styla-chat-input-{{ block.id }}" rows="1"
                  placeholder="Ask about sizing, fabric, or fit…"></textarea>
        <button type="button" class="styla-chat-send" id="styla-chat-send-{{ block.id }}" aria-label="Send">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

{{ 'styla-widget.css' | asset_url | stylesheet_tag }}
{% comment %}
  styla-fit-ui.js is a generated copy of shared/fit-ui.js (tools/sync-shared.mjs).
  It MUST load before styla-widget.js, which now delegates i18n, units, fit-fact
  sentences and the "may we recommend this?" decision to it. Both scripts are
  deferred, and deferred scripts execute in document order, so this is ordered.
{% endcomment %}
<script src="{{ 'styla-fit-ui.js' | asset_url }}" defer></script>
<script src="{{ 'styla-variant-size.js' | asset_url }}" defer></script>
<script src="{{ 'styla-pdp-variant.js' | asset_url }}" defer></script>
<script src="{{ 'styla-widget.js' | asset_url }}" defer></script>

{%- endif -%}{%- comment -%} /size-axis gate {%- endcomment -%}

{% schema %}
{
  "name": "Styla Fit Advisor",
  "target": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_without_sizes",
      "label": "Show on products with no sizes",
      "info": "Off by default. There is nothing to recommend on a one-size hat or a gift card, so the button is hidden there.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_without_chart",
      "label": "Hide until a size chart exists for the product",
      "info": "Off by default. With no chart Styla can still answer fit questions from the product details, so most stores should leave this off while charts are being added.",
      "default": false
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Auto-Size with STYLA"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background Color",
      "default": "#ff2a75"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
