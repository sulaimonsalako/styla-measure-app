{% comment %}
  STYLA Fit Advisor storefront widget block.
{% endcomment %}

<div class="styla-widget-container"
     id="styla-widget-{{ block.id }}"
     data-product-id="{{ product.id }}"
     data-product-title="{{ product.title | escape }}"
     data-product-handle="{{ product.handle }}"
     data-product-type="{{ product.type | escape }}"
     data-product-url="{{ shop.url }}{{ product.url }}"
     data-shop-domain="{{ shop.permanent_domain }}"
     data-product-desc="{{ product.description | strip_html | truncate: 600 | escape }}"
     data-customer-id="{{ customer.id }}"
     {{ block.shopify_attributes }}>
     
  <!-- PDP Button -->
  <button type="button" class="styla-fit-btn" id="styla-trigger-btn-{{ block.id }}" style="
    --btn-bg: {{ block.settings.btn_bg }};
    --btn-color: {{ block.settings.btn_color }};
  ">
    <svg class="styla-btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
      <circle cx="12" cy="7" r="4" />
    </svg>
    <span class="styla-btn-text">{{ block.settings.btn_label }}</span>
  </button>
</div>

<!-- Modal Structure (Text-based Layout) -->
<div class="styla-modal-overlay styla-hidden" id="styla-modal-{{ block.id }}">
  <div class="styla-modal-container">
    <!-- Close Button -->
    <button class="styla-modal-close" id="styla-close-{{ block.id }}">&times;</button>
    
    <div class="styla-modal-body">
      <!-- 1. Left Column: Product Featured Image -->
      <div class="styla-modal-left" style="background-image: url('{{ product.featured_image | image_url: width: 600 }}');">
        <div class="styla-product-overlay">
          <span class="styla-product-badge">GARMENT PREVIEW</span>
        </div>
      </div>
      
      <!-- 2. Right Column: Sizing & Chat Panel -->
      <div class="styla-modal-right">
        <!-- Tab Bar -->
        <div class="styla-tabs-bar">
          <div class="styla-tabs">
            <button class="styla-tab-btn active" data-tab="styla-tab-fit-{{ block.id }}">Fit Advisor</button>
            <button class="styla-tab-btn" data-tab="styla-tab-chat-{{ block.id }}">Ask AI Tailor</button>
          </div>
        </div>
        
        <!-- Tab Panel 1: Sizing Details (Clean Text-based Layout) -->
        <div class="styla-tab-content active" id="styla-tab-fit-{{ block.id }}">
          <div class="styla-text-rec-container">
            <!-- Top Section: Best Option Info & Edit Button -->
            <div class="styla-best-option-row">
              <div class="styla-best-option-box">
                <span class="styla-option-label">BEST OPTION</span>
                <div class="styla-option-val">
                  <span id="styla-best-size-val-{{ block.id }}">M</span>
                  <svg class="styla-check-icon" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                </div>
              </div>
              <button type="button" class="styla-edit-specs-btn" id="styla-edit-specs-{{ block.id }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                  <path d="M18.5 2.5a2.121 2.121 0 1 1 3 3L12 15l-4 1 1-4Z"></path>
                </svg>
                Edit Specs
              </button>
            </div>
            
            <!-- Sizing Details Content Area (Toggles with Input Form) -->
            <div class="styla-fit-details-body" id="styla-details-body-{{ block.id }}">
              <!-- Middle Section: Sizing Details List -->
              <div class="styla-fit-analysis-panel">
                <span class="styla-panel-title">Fit details relative to your body:</span>
                <ul class="styla-text-analysis-list" id="styla-text-list-{{ block.id }}">
                  <!-- Will be dynamically populated via JS -->
                </ul>
              </div>
              
              <!-- Designer Intent Card -->
              <div class="styla-intent-card">
                <p id="styla-intent-text-{{ block.id }}">Designed as a "Relaxed Fit" tee. Choosing Size S is NOT recommended because the Chest would fit tight (-0.5" ease).</p>
              </div>
              
              <!-- Bottom Section: Also Try Sizes slider -->
              <div class="styla-size-picker-section">
                <span class="styla-picker-title">Also try the sizes:</span>
                <div class="styla-size-slider-row">
                  <button type="button" class="styla-arrow-btn prev" id="styla-prev-size-{{ block.id }}">&lt;</button>
                  <div class="styla-size-options-list">
                    <button type="button" class="styla-size-opt-btn" data-size="S">S</button>
                    <button type="button" class="styla-size-opt-btn active" data-size="M">M</button>
                    <button type="button" class="styla-size-opt-btn" data-size="L">L</button>
                  </div>
                  <button type="button" class="styla-arrow-btn next" id="styla-next-size-{{ block.id }}">&gt;</button>
                </div>
              </div>
            </div>

            <!-- Manual Specs Input Form (Hidden by default) -->
            <div class="styla-specs-form styla-hidden" id="styla-form-{{ block.id }}">
              <span class="styla-form-title" id="styla-form-title-{{ block.id }}">A few quick questions — no tape measure needed.</span>

              <!-- QUESTIONNAIRE (default) -->
              <div id="styla-quiz-{{ block.id }}">
                <div class="styla-q">
                  <label>You're shopping for</label>
                  <div class="styla-seg" id="styla-q-gender-{{ block.id }}">
                    <button type="button" data-g="women" class="on">Women's</button>
                    <button type="button" data-g="men">Men's</button>
                  </div>
                </div>
                <div class="styla-q">
                  <label>Height <span class="styla-qval" id="styla-q-hlbl-{{ block.id }}">5'6"</span></label>
                  <input type="range" id="styla-q-height-{{ block.id }}" min="54" max="82" value="66">
                </div>
                <div class="styla-q">
                  <label>Weight <span class="styla-qval" id="styla-q-wlbl-{{ block.id }}">150 lb</span></label>
                  <input type="range" id="styla-q-weight-{{ block.id }}" min="90" max="330" value="150">
                </div>

                <div id="styla-q-women-{{ block.id }}">
                  <div class="styla-form-grid">
                    <div class="styla-form-group">
                      <label>Bra band</label>
                      <select id="styla-q-band-{{ block.id }}"><option>30</option><option>32</option><option selected>34</option><option>36</option><option>38</option><option>40</option><option>42</option></select>
                    </div>
                    <div class="styla-form-group">
                      <label>Cup</label>
                      <select id="styla-q-cup-{{ block.id }}"><option>A</option><option selected>B</option><option>C</option><option>D</option><option>DD</option><option>F</option></select>
                    </div>
                  </div>
                  <div class="styla-q">
                    <label>Usual waist size (in) <span class="styla-qval" id="styla-q-wwlbl-{{ block.id }}">28 in</span></label>
                    <input type="range" id="styla-q-ww-{{ block.id }}" min="22" max="48" value="28">
                  </div>
                </div>

                <div id="styla-q-men-{{ block.id }}" style="display:none">
                  <div class="styla-form-group">
                    <label>Usual shirt size</label>
                    <select id="styla-q-shirt-{{ block.id }}"><option>XS</option><option>S</option><option selected>M</option><option>L</option><option>XL</option><option>XXL</option></select>
                  </div>
                  <div class="styla-q">
                    <label>Usual waist size (in) <span class="styla-qval" id="styla-q-wmlbl-{{ block.id }}">32 in</span></label>
                    <input type="range" id="styla-q-wm-{{ block.id }}" min="26" max="54" value="32">
                  </div>
                </div>

                <div class="styla-q">
                  <label>How do you like things to fit?</label>
                  <div class="styla-seg" id="styla-q-fit-{{ block.id }}">
                    <button type="button" data-f="snug">Fitted</button>
                    <button type="button" data-f="regular" class="on">Regular</button>
                    <button type="button" data-f="loose">Relaxed</button>
                  </div>
                </div>
                <button type="button" class="styla-switchmode" id="styla-to-manual-{{ block.id }}">I know my measurements →</button>
              </div>

              <!-- EXACT MEASUREMENTS (optional) -->
              <div id="styla-manual-{{ block.id }}" style="display:none">
                <div class="styla-form-grid">
                  <div class="styla-form-group">
                    <label for="styla-in-chest-{{ block.id }}">Chest / bust (in)</label>
                    <input type="number" id="styla-in-chest-{{ block.id }}" placeholder="38" step="0.5" min="20" max="70">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-in-waist-{{ block.id }}">Waist (in)</label>
                    <input type="number" id="styla-in-waist-{{ block.id }}" placeholder="32" step="0.5" min="20" max="70">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-in-hips-{{ block.id }}">Hips (in)</label>
                    <input type="number" id="styla-in-hips-{{ block.id }}" placeholder="40" step="0.5" min="20" max="80">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-in-height-{{ block.id }}">Height (in)</label>
                    <input type="number" id="styla-in-height-{{ block.id }}" placeholder="66" step="0.5" min="48" max="84">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-in-shoulders-{{ block.id }}">Shoulder (in) <span class="styla-opt">optional</span></label>
                    <input type="number" id="styla-in-shoulders-{{ block.id }}" placeholder="17" step="0.1" min="10" max="30">
                  </div>
                  <div class="styla-form-group">
                    <label for="styla-in-inseam-{{ block.id }}">Inseam (in) <span class="styla-opt">optional</span></label>
                    <input type="number" id="styla-in-inseam-{{ block.id }}" placeholder="30" step="0.5" min="20" max="40">
                  </div>
                </div>
                <button type="button" class="styla-switchmode" id="styla-to-quiz-{{ block.id }}">← Answer a few questions instead</button>
              </div>
              <div class="styla-form-actions">
                <button type="button" class="styla-form-btn cancel" id="styla-cancel-specs-{{ block.id }}">Cancel</button>
                <button type="button" class="styla-form-btn save" id="styla-save-specs-{{ block.id }}">Calculate Fit</button>
              </div>
            </div>
            
          </div>
        </div>
        
        <!-- Tab Panel 2: AI Tailor Chat -->
        <div class="styla-tab-content" id="styla-tab-chat-{{ block.id }}">
          <div class="styla-chat-container">
            <div class="styla-chat-history" id="styla-chat-history-{{ block.id }}">
              <div class="chat-msg system">
                <p>Hello! I am your STYLA AI Tailor. Ask me anything about how this item fits your body, its fabric composition, or styling suggestions.</p>
              </div>
            </div>
            <div class="styla-chat-input-bar">
              <input type="text" class="styla-chat-input" id="styla-chat-input-{{ block.id }}" placeholder="Ask about sizing, fabric, or fit...">
              <button type="button" class="styla-chat-send" id="styla-chat-send-{{ block.id }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{{ 'styla-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'styla-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Styla Fit Advisor",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Auto-Size with STYLA"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background Color",
      "default": "#ff2a75"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
